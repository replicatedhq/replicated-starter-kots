#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

echo "Running tests..."

# Helm unittest
if helm plugin list | grep -q "unittest"; then
  echo "Running Helm unit tests..."
  helm unittest "${PROJECT_ROOT}/charts/app"
else
  echo "Helm unittest plugin not found. Skipping."
  echo "Install via: helm plugin install https://github.com/helm-unittest/helm-unittest.git"
fi

echo "Tests complete."
